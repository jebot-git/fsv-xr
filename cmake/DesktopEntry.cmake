# Shared policy, vendored by independently installable de-xr projects.
# Detect sessions at install time, so adding DomeD never requires a rebuild.
function(de_xr_install_desktop_entry domed xr)
  set(DE_XR_SESSION_ROOT "" CACHE PATH "Session filesystem root (empty: staged tree and host)")
  set(xr_enabled TRUE)
  if(ARGC GREATER 2)
    set(xr_enabled "${ARGV2}")
  endif()
  set(entry_code [=[
    set(session_roots "@DE_XR_SESSION_ROOT@")
    if(session_roots STREQUAL "")
      set(session_roots "$ENV{DESTDIR}" "/")
    endif()
    set(has_domed FALSE)
    foreach(root IN LISTS session_roots)
      foreach(data IN ITEMS "${CMAKE_INSTALL_PREFIX}/share" /usr/local/share /usr/share)
        foreach(kind IN ITEMS wayland-sessions xsessions)
          foreach(session IN ITEMS dome domed)
            set(path "${root}${data}/${kind}/${session}.desktop")
            if(EXISTS "${path}")
              file(STRINGS "${path}" hidden REGEX "^[ \t]*Hidden[ \t]*=[ \t]*true[ \t]*$")
              if(NOT hidden)
                set(has_domed TRUE)
              endif()
            endif()
          endforeach()
        endforeach()
      endforeach()
    endforeach()
    set(selected "@xr@")
    set(obsolete "@domed@")
    if(has_domed OR NOT @xr_enabled@)
      set(selected "@domed@")
      set(obsolete "@xr@")
    endif()
    set(destination "${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_DATADIR@/applications")
    if(IS_ABSOLUTE "@CMAKE_INSTALL_DATADIR@")
      set(destination "@CMAKE_INSTALL_DATADIR@/applications")
    endif()
    file(INSTALL DESTINATION "${destination}" TYPE FILE FILES "${selected}")
    if(NOT obsolete STREQUAL "")
      get_filename_component(obsolete_name "${obsolete}" NAME)
      file(REMOVE "$ENV{DESTDIR}${destination}/${obsolete_name}")
    endif()
  ]=])
  string(CONFIGURE "${entry_code}" entry_code @ONLY)
  install(CODE "${entry_code}" COMPONENT DesktopEntry)
endfunction()
