[Desktop Entry]
Type=Application
Name=fsvr
Comment=Explore the filesystem in 3D and OpenXR
Exec=fsvr %U
TryExec=fsvr
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
Keywords=filesystem;files;archives;extract;compress;3D;OpenGL;XR;DomeD;
MimeType=inode/directory;x-scheme-handler/trash;
StartupWMClass=org.fsvxr.fsvr
Actions=Desktop;DomeD;

[Desktop Action Desktop]
Name=Use Desktop Presentation
Exec=fsvr --desktop %U

[Desktop Action DomeD]
Name=Open in Current DomeD Session
Exec=fsvr %U
