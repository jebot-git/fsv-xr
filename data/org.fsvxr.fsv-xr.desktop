[Desktop Entry]
Type=Application
Name=fsv-xr
Comment=Explore the filesystem in 3D and OpenXR
Exec=fsv-xr %f
TryExec=fsv-xr
Icon=system-file-manager
Terminal=false
Categories=System;FileManager;
Keywords=filesystem;files;3D;Vulkan;XR;DomeD;
MimeType=inode/directory;
StartupWMClass=org.fsvxr.fsv-xr
Actions=Desktop;DomeD;

[Desktop Action Desktop]
Name=Open on Desktop
Exec=fsv-xr --desktop %f

[Desktop Action DomeD]
Name=Open in Current DomeD Session
Exec=fsv-xr --domed %f
