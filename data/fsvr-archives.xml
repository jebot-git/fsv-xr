<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/warc">
    <comment>WARC archive</comment>
    <glob pattern="*.warc"/>
    <magic priority="60"><match type="string" offset="0" value="WARC/"/></magic>
  </mime-type>
  <mime-type type="application/x-mtree">
    <comment>mtree metadata manifest</comment>
    <glob pattern="*.mtree"/>
    <magic priority="60"><match type="string" offset="0" value="#mtree"/></magic>
  </mime-type>
  <mime-type type="application/x-cpio-compressed">
    <glob pattern="*.cpio.xz"/>
    <glob pattern="*.cpio.zst"/>
  </mime-type>
</mime-info>
