diff --git a/src/launch_context.rs b/src/launch_context.rs
new file mode 100644
index 0000000..ccc7720
--- /dev/null
+++ b/src/launch_context.rs
@@ -0,0 +1,64 @@
+//! Per-socket launch realm, independent of headset visibility and input ownership.
+use crate::Realm;
+use serde::{Deserialize, Serialize};
+use std::{fs, io, os::unix::fs::OpenOptionsExt, path::PathBuf};
+
+#[derive(Debug, Serialize, Deserialize)]
+pub struct Context {
+    pub version: u32,
+    pub compositor_pid: u32,
+    pub realm: Realm,
+}
+pub struct Registration(PathBuf);
+impl Registration {
+    pub fn publish(socket: &std::ffi::OsStr, realm: Realm) -> io::Result<Self> {
+        use std::io::Write;
+        let socket = PathBuf::from(socket);
+        let socket = if socket.is_absolute() { socket } else {
+            PathBuf::from(std::env::var_os("XDG_RUNTIME_DIR").ok_or_else(|| io::Error::other("XDG_RUNTIME_DIR missing"))?).join(socket)
+        };
+        let path = PathBuf::from(format!("{}.dome-session.json", socket.display()));
+        let temporary = path.with_extension(format!("tmp-{}", std::process::id()));
+        let context = Context { version: 1, compositor_pid: std::process::id(), realm };
+        let mut file = fs::OpenOptions::new().write(true).create_new(true).mode(0o600).open(&temporary)?;
+        let result = (|| {
+            file.write_all(&serde_json::to_vec(&context)?)?;
+            fs::rename(&temporary, &path)
+        })();
+        if result.is_err() { let _ = fs::remove_file(&temporary); }
+        result?;
+        Ok(Self(path))
+    }
+}
+impl Drop for Registration {
+    fn drop(&mut self) {
+        // A newly started compositor may already have reused the socket name.
+        let ours = fs::read(&self.0).ok().and_then(|bytes| serde_json::from_slice::<Context>(&bytes).ok())
+            .is_some_and(|context| context.compositor_pid == std::process::id());
+        if ours { let _ = fs::remove_file(&self.0); }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+    #[test]
+    fn socket_records_are_private_versioned_and_cleaned_up() {
+        let unique = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();
+        let directory = std::env::temp_dir().join(format!("dome-context-{}-{unique}", std::process::id()));
+        fs::create_dir(&directory).unwrap();
+        for realm in [Realm::Desktop, Realm::Xr] {
+            let socket = directory.join(if realm == Realm::Xr { "wayland-xr" } else { "wayland-desktop" });
+            let registration = Registration::publish(socket.as_os_str(), realm).unwrap();
+            let context: Context = serde_json::from_slice(&fs::read(&registration.0).unwrap()).unwrap();
+            assert_eq!(context.version, 1);
+            assert_eq!(context.compositor_pid, std::process::id());
+            assert_eq!(context.realm, realm);
+            assert_eq!(fs::metadata(&registration.0).unwrap().permissions().mode() & 0o777, 0o600);
+            let path = registration.0.clone(); drop(registration);
+            assert!(!path.exists());
+        }
+        fs::remove_dir(directory).unwrap();
+    }
+}
diff --git a/src/file_manager.rs b/src/file_manager.rs
new file mode 100644
index 0000000..8a2dcc8
--- /dev/null
+++ b/src/file_manager.rs
@@ -0,0 +1,33 @@
+//! Folder launches always inherit the caller's Wayland realm; never start a second XR runtime.
+use std::{ffi::OsString, io, process::Command};
+
+pub fn command_for(socket: &str, binary: OsString, arguments: &[String]) -> Command {
+    let mut command = Command::new(binary);
+    command.args(arguments)
+        .env("WAYLAND_DISPLAY", socket)
+        .env_remove("WAYLAND_SOCKET")
+        .env("QT_QPA_PLATFORM", "wayland")
+        .env("GDK_BACKEND", "wayland")
+        .env("XDG_CURRENT_DESKTOP", "Dome");
+    command
+}
+pub fn launch(socket: &str, arguments: &[String]) -> io::Result<()> {
+    let binary = std::env::var_os("DOME_FILE_MANAGER").unwrap_or_else(|| "fsvr".into());
+    let mut child = command_for(socket, binary, arguments).spawn()?;
+    std::thread::spawn(move || { let _ = child.wait(); });
+    Ok(())
+}
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn folder_launch_keeps_selected_realm_and_literal_urls() {
+        for socket in ["dome-desktop-test", "dome-xr-test"] {
+            let args = vec!["--select".into(), "--".into(), "file:///tmp/a%20%23%20file".into()];
+            let command = super::command_for(socket, "fsvr".into(), &args);
+            assert_eq!(command.get_args().collect::<Vec<_>>(), ["--select", "--", "file:///tmp/a%20%23%20file"]);
+            assert!(command.get_envs().any(|(key, value)| key == "WAYLAND_DISPLAY" && value == Some(socket.as_ref())));
+            assert!(command.get_envs().any(|(key, value)| key == "WAYLAND_SOCKET" && value.is_none()));
+            assert!(!command.get_args().any(|a| a == "--xr" || a == "--desktop" || a == "--domed"));
+        }
+    }
+}
diff --git a/src/bin/dome-compositor/file_manager.rs b/src/bin/dome-compositor/file_manager.rs
new file mode 100644
index 0000000..56912ff
--- /dev/null
+++ b/src/bin/dome-compositor/file_manager.rs
@@ -0,0 +1,69 @@
+//! FileManager1 belongs to the Dome login session, not a nested host desktop.
+use dome::xr_transport::Shared;
+use std::os::unix::ffi::OsStrExt;
+use zbus::{message::Header, Connection};
+struct Server { desktop: String, xr: String, bridge: Shared }
+impl Server {
+    async fn socket(&self, connection: &Connection, header: &Header<'_>) -> String {
+        // A background desktop application must not open an XR-only window just
+        // because the headset owns input. Prefer the requesting process's realm.
+        if let Some(sender) = header.sender() {
+            if let Ok(reply) = connection.call_method(Some("org.freedesktop.DBus"), "/org/freedesktop/DBus",
+                Some("org.freedesktop.DBus"), "GetConnectionUnixProcessID", &(sender.as_str(),)).await {
+                if let Ok(pid) = reply.body().deserialize::<u32>() {
+                    if let Ok(environment) = std::fs::read(format!("/proc/{pid}/environ")) {
+                        for entry in environment.split(|b| *b == 0) {
+                            if let Some(display) = entry.strip_prefix(b"WAYLAND_DISPLAY=") {
+                                let display = std::path::Path::new(std::ffi::OsStr::from_bytes(display));
+                                if display.file_name() == std::path::Path::new(&self.xr).file_name() { return self.xr.clone(); }
+                                if display.file_name() == std::path::Path::new(&self.desktop).file_name() { return self.desktop.clone(); }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        if self.bridge.lock().unwrap().input_realm == dome::Realm::Xr { self.xr.clone() } else { self.desktop.clone() }
+    }
+    async fn open(&self, urls: Vec<String>, startup: String, option: Option<&str>, connection: &Connection, header: &Header<'_>) -> zbus::fdo::Result<()> {
+        if urls.len() > 32 || urls.iter().map(String::len).sum::<usize>() > 65536 {
+            return Err(zbus::fdo::Error::LimitsExceeded("At most 32 local locations per request".into()));
+        }
+        // fsvr owns URL decoding, file validation and error presentation.
+        if urls.is_empty() { return Ok(()); }
+        if urls.iter().any(|url| !(url.starts_with("file://") || url == "trash:/" || url == "trash:///")) {
+            return Err(zbus::fdo::Error::InvalidArgs("Only local file URLs and trash:/ are supported".into()));
+        }
+        let socket = self.socket(connection, header).await;
+        let mut arguments: Vec<String> = option.into_iter().map(str::to_owned).collect();
+        arguments.push("--".into()); arguments.extend(urls);
+        let binary = std::env::var_os("DOME_FILE_MANAGER").unwrap_or_else(|| "fsvr".into());
+        let mut command = dome::file_manager::command_for(&socket, binary, &arguments);
+        if !startup.is_empty() { command.env("DESKTOP_STARTUP_ID", startup); }
+        let mut child = command.spawn().map_err(|e| zbus::fdo::Error::Failed(format!("Cannot launch file manager: {e}")))?;
+        std::thread::spawn(move || { let _ = child.wait(); });
+        Ok(())
+    }
+}
+#[zbus::interface(name = "org.freedesktop.FileManager1")]
+impl Server {
+    async fn show_folders(&self, uris: Vec<String>, startup_id: String, #[zbus(connection)] connection: &Connection, #[zbus(header)] header: Header<'_>) -> zbus::fdo::Result<()> {
+        self.open(uris, startup_id, None, connection, &header).await
+    }
+    async fn show_items(&self, uris: Vec<String>, startup_id: String, #[zbus(connection)] connection: &Connection, #[zbus(header)] header: Header<'_>) -> zbus::fdo::Result<()> {
+        self.open(uris, startup_id, Some("--select"), connection, &header).await
+    }
+    async fn show_item_properties(&self, uris: Vec<String>, startup_id: String, #[zbus(connection)] connection: &Connection, #[zbus(header)] header: Header<'_>) -> zbus::fdo::Result<()> {
+        self.open(uris, startup_id, Some("--properties"), connection, &header).await
+    }
+}
+pub fn start(desktop: String, xr: String, bridge: Shared) -> Option<zbus::blocking::Connection> {
+    let configured = std::env::var("DOME_FILE_MANAGER_SERVICE").ok();
+    if configured.as_deref() == Some("0") || (configured.as_deref() != Some("1") && std::env::var("DOME_LOGIN_SESSION").as_deref() != Ok("1")) { return None; }
+    match zbus::blocking::connection::Builder::session().and_then(|b| b.name("org.freedesktop.FileManager1"))
+        .and_then(|b| b.serve_at("/org/freedesktop/FileManager1", Server { desktop, xr, bridge }))
+        .and_then(|b| b.build()) {
+        Ok(connection) => Some(connection),
+        Err(error) => { eprintln!("Dome FileManager1 unavailable (an existing owner is preserved): {error}"); None }
+    }
+}
